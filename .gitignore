# Environment
.env
.envrc
.env.*
!.env.example

# Dependencies / build
node_modules/
dist/
coverage/

# ETL cache (raw FPL responses; safe to delete, refetched on next run)
.etl-cache/

# OS
.DS_Store

# Playwright browsers downloaded locally (root cache is not writable)
.pw-browsers/

# Raw manually-saved FBref HTML — parsed output is committed as data/fbref.json
# (the capture-instructions README inside stays tracked)
data/fbref-raw/*
!data/fbref-raw/README.md

# Raw saved Underdog draft pages — parsed into room records (see #22)
data/udraft-raw/*
!data/udraft-raw/README.md
